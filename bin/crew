#!/usr/bin/env python3
"""crew PANE SUBAGENTS_DIR: spin $crew ("⠋ N", the deck's spinner) on the agent's pane and its
workspace in herdr's sidebar while N agents work there: the main agent (while its turn runs)
plus its subagents.

Started by bin/sidebar.py on a tool call, the main agent's or a subagent's; one per pane (a pid
file, crew.pid, in the deck's state dir): a thread of bin/steadingd.py, or its own process
(crew PANE SUBAGENTS_DIR) when the daemon cannot start. Every frame goes straight to herdr's
socket (~8 a second, far lighter than the CLI). It recounts once a second (the subagents at work by Claude Code's hooks,
as bin/subagents.py records them for the deck too, plus the main agent while its turn runs),
and once none is at work it clears the tokens
and exits. Each report lapses in 3 s, so a crash leaves nothing behind."""
import json, os, shutil, socket, sys, time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))  # -I leaves the script's folder out
import reexec, steadingd, subagents  # noqa: E402

OWNERS = ("crew", "steadingd.py")  # who may hold a pane's crew.pid: this script, or the daemon running it
FRAMES = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
QUIET = 90  # fallback, a subagent the hooks never named: seconds without writing before it stops


def call(method, params):
    s = socket.socket(socket.AF_UNIX)
    s.settimeout(2)
    s.connect(os.environ["HERDR_SOCKET_PATH"])
    s.sendall((json.dumps({"id": "steading-crew", "method": method, "params": params}) + "\n").encode())
    buf = b""
    while not buf.endswith(b"\n"):
        chunk = s.recv(65536)
        if not chunk:
            break
        buf += chunk
    s.close()
    return json.loads(buf or b"{}").get("result", {})


def live(root, folder):
    """Subagents at work: those Claude Code's hooks say are (bin/subagents.py, the record the
    deck reads too), and, of those the hooks never named (a session begun before the record),
    the ones that wrote their transcripts in the last 90 s."""
    rec = subagents.states(root, os.path.basename(os.path.dirname(folder)), folder=folder) or {}
    n = sum(1 for state, _ in rec.values() if state == "working")
    try:
        names = os.listdir(folder)
    except OSError:
        return n
    for f in names:
        if f.startswith("agent-") and f.endswith(".jsonl") and f[len("agent-"):-len(".jsonl")] not in rec:
            try:
                n += time.time() - os.path.getmtime(os.path.join(folder, f)) < QUIET
            except OSError:
                pass
    return n


def report(pane, space, value, ttl=3000):
    tokens = {"crew": value}
    call("pane.report_metadata", {"pane_id": pane, "source": "steading-crew", "tokens": tokens, "ttl_ms": ttl})
    if space:
        call("workspace.report_metadata", {"workspace_id": space, "source": f"steading-crew-{pane}",
                                           "tokens": tokens, "ttl_ms": ttl})


def at_work(state, folder):
    """Subagents at work, plus the main agent while its turn runs (bin/sidebar.py marks it from
    Claude Code's own hooks; herdr reads Claude off the screen and calls it idle while a tool runs).
    A mark older than 10 minutes is a turn that ended without its Stop hook."""
    try:
        lead = time.time() - os.path.getmtime(os.path.join(state, "main-busy")) < 600
    except OSError:
        lead = False
    return live(os.path.dirname(state), folder) + lead


def paths(pane):
    """The pane's state folder and its crew's pid file."""
    state = os.path.join(os.environ.get("TMPDIR", "/tmp"), "steading", pane.replace(":", "_").replace("/", "_"))
    return state, os.path.join(state, "crew.pid")


def main(pane, folder, state, watch=True):
    """The loop; it returns once none is at work. watch=False in the daemon, whose own watcher
    re-execs it."""
    space = call("pane.get", {"pane_id": pane}).get("pane", {}).get("workspace_id")
    n, counted, frame = at_work(state, folder), 0.0, 0
    check = reexec.watcher() if watch else (lambda: None)
    while True:
        check()
        if time.time() - counted >= 1:
            n, counted = at_work(state, folder), time.time()
            if not n:
                report(pane, space, None)  # null clears the token
                return
        report(pane, space, f"{FRAMES[frame % len(FRAMES)]} {n}")
        frame += 1
        time.sleep(0.125)


if __name__ == "__main__":
    pane, folder = sys.argv[1], sys.argv[2]
    state, pidfile = paths(pane)
    os.makedirs(state, exist_ok=True)
    shutil.rmtree(os.path.join(state, "agents"), ignore_errors=True)  # markers of the old format: nothing reads them now
    if not steadingd.claim(pidfile, OWNERS):  # one spinner per pane, here or in the daemon
        sys.exit(0)
    try:
        main(pane, folder, state)
    except (OSError, ValueError, KeyError):
        pass
    finally:
        steadingd.release(pidfile)
