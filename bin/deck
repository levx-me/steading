#!/usr/bin/env bash
# Open and close the deck from herdr itself, for any agent or plain shell.
#
#   deck toggle   herdr action (prefix+d): open the deck beside the focused pane,
#                 or close it; on the deck itself, close that deck
#   deck auto     herdr event pane.agent_detected: open a deck beside the pane
#                 an agent (claude, codex, opencode, ...) just showed up in.
#                 Off with "Open with agents" in the deck's settings (or a
#                 $HERDR_PLUGIN_CONFIG_DIR/no-auto-open file).
#   deck flip BASE  L in a deck: reopen it on the other side of its agent (right
#                 or above); that agent's deck keeps opening there.
set -u
root=$(cd "$(dirname "$0")/.." && pwd)
state="${TMPDIR:-/tmp}/steading"

alive() { [ -n "$1" ] && herdr pane get "$1" >/dev/null 2>&1; }
deck_of() { cat "$state/$(printf '%s' "$1" | tr ':/' '__')/pane" 2>/dev/null; }
is_deck() { grep -qxF "$1" "$state"/*/pane 2>/dev/null; }
open_beside() { HERDR_PANE_ID=$1 "$root/bin/pane" "" "${2:-$PWD}" >/dev/null; }

case ${1:-} in
  toggle)
    ctx=${HERDR_PLUGIN_CONTEXT_JSON:-'{}'}
    pane=$(printf '%s' "$ctx" | jq -r '.focused_pane_id // empty')
    cwd=$(printf '%s' "$ctx" | jq -r '.focused_pane_cwd // empty')
    [ -n "$pane" ] || exit 0
    if is_deck "$pane"; then
      herdr pane close "$pane" >/dev/null
    elif alive "$(deck_of "$pane")"; then
      herdr pane close "$(deck_of "$pane")" >/dev/null
    else
      STEADING_REPLACE=1 open_beside "$pane" "$cwd"
      # Opened by hand: the focus goes to the deck (it opens without, for runs and agent starts).
      side=$(cat "$state/$(printf '%s' "$pane" | tr ':/' '__')/placement" 2>/dev/null)
      herdr pane focus --pane "$pane" --direction "${side:-right}" >/dev/null 2>&1
    fi
    ;;
  auto)
    config=${HERDR_PLUGIN_CONFIG_DIR:-$HOME/.config/herdr/plugins/config/steading}
    [ -e "$config/no-auto-open" ] && exit 0
    # Off in the deck's settings (",": Open with agents).
    [ "$(jq -r '.open_with_agents | tostring' "$config/settings.json" 2>/dev/null)" = false ] && exit 0
    pane=$(printf '%s' "${HERDR_PLUGIN_EVENT_JSON:-'{}'}" | jq -r '.data.pane_id // empty')
    [ -n "$pane" ] && ! is_deck "$pane" || exit 0
    cwd=$(herdr pane get "$pane" | jq -r '.result.pane.cwd // empty')
    open_beside "$pane" "$cwd"
    ;;
  flip)
    base=${2:?usage: deck flip BASE}
    agent=$(cat "$base/agent" 2>/dev/null)
    # A deck opened before bin/pane kept the agent: the pane whose id names the base.
    [ -n "$agent" ] || agent=$(herdr pane list 2>/dev/null | jq -r '.result.panes[].pane_id' |
      while read -r p; do [ "$(printf '%s' "$p" | tr ':/' '__')" = "$(basename "$base")" ] && echo "$p"; done | head -n 1)
    [ -n "$agent" ] || exit 1
    # Flips take turns with each other and with openers (bin/pane), so a burst of L
    # never leaves more than one deck.
    until mkdir "$base/lock" 2>/dev/null; do
      [ -n "$(find "$base/lock" -maxdepth 0 -mmin +1 2>/dev/null)" ] && rmdir "$base/lock" 2>/dev/null
      sleep 0.1
    done
    trap 'rmdir "$base/lock" 2>/dev/null' EXIT
    export STEADING_LOCKED=1
    [ "$(cat "$base/placement" 2>/dev/null)" = up ] && to=right || to=up
    printf '%s\n' "$to" > "$base/placement"
    old=$(cat "$base/pane" 2>/dev/null)
    focused=$(herdr pane get "$old" 2>/dev/null | jq -r '.result.pane.focused')
    alive "$old" && herdr pane close "$old" >/dev/null
    # The same TMPDIR the deck was opened with, so the new one finds its runs.
    TMPDIR=$(dirname "$(dirname "$base")") open_beside "$agent" "$(cat "$base/root" 2>/dev/null)"
    # L was pressed in the deck: the focus stays in it, on its new side of the agent.
    [ "$focused" = true ] && herdr pane focus --pane "$agent" --direction "$to" >/dev/null 2>&1
    ;;
  *)
    echo "usage: deck toggle|auto|flip BASE" >&2
    exit 2
    ;;
esac
