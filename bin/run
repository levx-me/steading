#!/usr/bin/env bash
# Run a test or build for the agent, record it for the deck, and hand the
# output and exit code back to the caller (Claude's Bash tool).
#
#   run <test|build> <base64 command> [<base64 output filter>] [<base64 label>]
#
# Each run lives in $TMPDIR/steading/<agent pane>/<kind>/runs/<n>/ (cmd, cwd,
# log, start, pid, then rc and end). The deck (bin/pane, bin/viewer.py) shows
# it in the kind's section beside the agent and switches to it.
set -u

kind=$1
arg() { [ "${1:--}" = - ] || printf '%s' "$1" | base64 -d; } # "-" stands for empty
cmd=$(arg "$2")
post=$(arg "${3:-}")
label=$(arg "${4:-}")
root=$(cd "$(dirname "$0")/.." && pwd)

finish() { # stdout for the agent, then the command's exit code
  if [ -n "$post" ]; then bash -c "$post"; else cat; fi
}

# Outside herdr just run it.
if [ "${HERDR_ENV:-}" != 1 ] || [ -z "${HERDR_PANE_ID:-}" ] || ! command -v herdr >/dev/null; then
  bash -c "$cmd" 2>&1 | finish
  exit "${PIPESTATUS[0]}"
fi

dir="${TMPDIR:-/tmp}/steading/$(printf '%s' "$HERDR_PANE_ID" | tr ':/' '__')/$kind"
mkdir -p "$dir/runs"
"$root/bin/pane" --follow "$kind" >/dev/null

# Next run number; keep the newest 20 runs.
n=$(ls "$dir/runs" | sort -n | tail -1); n=$(( ${n:-0} + 1 ))
ls "$dir/runs" | sort -rn | tail -n +20 | while read -r old; do rm -rf "${dir:?}/runs/$old"; done
r="$dir/runs/$n"
mkdir -p "$r"
printf '%s\n' "$cmd" > "$r/cmd"
[ -n "$label" ] && printf '%s\n' "$label" > "$r/label"
printf '%s\n' "$PWD" > "$r/cwd"
date +%s > "$r/start"
printf '%s\n' "$$" > "$r/pid"

# On a pseudo-terminal (bin/ptyrun) runners colour their output as in a shell;
# the colour variables cover the ones that still look at CI. CI=1 stops watch modes.
CI=1 FORCE_COLOR=1 CLICOLOR_FORCE=1 PY_COLORS=1 CARGO_TERM_COLOR=always \
  "$root/bin/py" "$root/bin/ptyrun" "$r/log" bash -c "$cmd"
rc=$?
printf '%s\n' "$rc" > "$r/rc"
date +%s > "$r/end"

# Plain text for the agent: drop colour codes, OSC sequences and carriage returns.
# A carriage return redraws its line (spinners, progress): keep what was drawn last.
out=$(perl -pe 's/\e\[[0-9;?]*[ -\/]*[@-~]//g; s/\e\][^\a\e]*(\a|\e\\)//g; s/\r+$//; s/^.*\r//' "$r/log")


printf '%s\n' "$out" | finish
exit "$rc"
