#!/usr/bin/env bash
# Make sure the agent has its Steading deck: one viewer pane split off to the
# right (or above, where L last put it), with agents, jobs, servers, build, test, git and deploy sections. Prints the pane id.
#
#   pane [--follow] [SECTION] [CWD]
#                           SECTION (agents|jobs|servers|build|test|git|deploy) is brought forward;
#                           CWD (default $PWD) picks the project for servers.
#                           --follow: only switch an open deck, never open one (runs use it;
#                           the deck opens from prefix+d or when an agent starts).
set -u
follow=
[ "${1:-}" = --follow ] && { follow=1; shift; }
section=${1:-}
cwd=${2:-$PWD}
agent=${HERDR_PANE_ID:?not inside a herdr pane}
root=$(cd "$(dirname "$0")/.." && pwd)

base="${TMPDIR:-/tmp}/steading/$(printf '%s' "$agent" | tr ':/' '__')"
mkdir -p "$base"
# Project root, for the servers section.
git -C "$cwd" rev-parse --show-toplevel 2>/dev/null > "$base/root" || printf '%s\n' "$cwd" > "$base/root"
[ -n "$section" ] && printf '%s\n' "$section" > "$base/focus"

# One deck per agent: openers (an agent starting, prefix+t, L pressed fast) take turns,
# so a second one finds the first one's deck instead of opening its own.
# bin/deck flip holds the lock already (STEADING_LOCKED).
if [ -z "${STEADING_LOCKED:-}" ]; then
  until mkdir "$base/lock" 2>/dev/null; do
    # A lock left by an opener that died (a minute old): take it over.
    [ -n "$(find "$base/lock" -maxdepth 0 -mmin +1 2>/dev/null)" ] && rmdir "$base/lock" 2>/dev/null
    sleep 0.1
  done
  trap 'rmdir "$base/lock" 2>/dev/null' EXIT
fi
pane=$(cat "$base/pane" 2>/dev/null)
if [ -n "$pane" ] && herdr pane get "$pane" >/dev/null 2>&1; then
  printf '%s\n' "$pane"
  exit 0
fi
[ -n "$follow" ] && exit 0

# One deck per tab: a second agent in the tab (another Claude, a split) gets none of its
# own; prefix+d (STEADING_REPLACE) moves the tab's deck over to it instead. Openers in the
# same tab take turns, so two agents starting at once still leave one deck.
tab=$(herdr pane get "$agent" 2>/dev/null | jq -r '.result.pane.tab_id // empty')
if [ -n "$tab" ]; then
  tablock="$(dirname "$base")/tab-$(printf '%s' "$tab" | tr ':/' '__').lock"
  until mkdir "$tablock" 2>/dev/null; do
    [ -n "$(find "$tablock" -maxdepth 0 -mmin +1 2>/dev/null)" ] && rmdir "$tablock" 2>/dev/null
    sleep 0.1
  done
  trap 'rmdir "$tablock" 2>/dev/null; [ -n "${STEADING_LOCKED:-}" ] || rmdir "$base/lock" 2>/dev/null' EXIT
  decks=$(awk 1 "$(dirname "$base")"/*/pane 2>/dev/null)  # awk 1: each file ends without a newline
  other=$(herdr pane list 2>/dev/null | jq -r --arg t "$tab" '.result.panes[] | select(.tab_id == $t) | .pane_id' |
    grep -xF -f <(printf '%s\n' "$decks") | head -n 1)
  if [ -n "$other" ]; then
    [ -n "${STEADING_REPLACE:-}" ] || exit 0
    herdr pane close "$other" >/dev/null 2>&1
  fi
fi
printf '%s\n' "$agent" > "$base/agent" # for L in the deck (bin/deck flip)

# Beside the agent (right) unless L in this agent's deck put it above.
placement=$(cat "$base/placement" 2>/dev/null)
[ "$placement" = up ] || placement=right
# herdr splits right or down; a deck on top is split below, then swapped up.
direction=right; [ "$placement" = up ] && direction=down

# herdr starts the deck straight in a split (the plugin's "deck" pane), so no
# shell shows first and nothing a shell might ask at startup gets in the way.
pane=$(herdr plugin pane open --plugin steading --entrypoint deck --placement split --target-pane "$agent" \
  --direction "$direction" --env "STEADING_BASE=$base" --no-focus 2>/dev/null |
  jq -r '.result.plugin_pane.pane.pane_id // empty')
if [ -z "$pane" ]; then
  # The herdr plugin is not installed (only the Claude Code side): split a shell
  # and start the deck in it.
  pane=$(herdr pane split --pane "$agent" --direction "$direction" --ratio 0.6 --cwd "$cwd" --no-focus |
    jq -r '.result.pane.pane_id // empty')
  [ -n "$pane" ] || exit 1
  herdr pane rename "$pane" "Steading" >/dev/null 2>&1
  sleep 0.4 # let the new shell reach its prompt
  # exec: the deck replaces the shell, so quitting it closes the pane.
  herdr pane run "$pane" "exec python3 $(printf '%q' "$root/bin/viewer.py") $(printf '%q' "$base")" >/dev/null
fi
if [ "$placement" = up ]; then
  # The swap takes the focus along with the place: hand it back to the agent if it had it.
  had=$(herdr pane get "$agent" 2>/dev/null | jq -r '.result.pane.focused')
  herdr pane swap --pane "$pane" --direction up >/dev/null 2>&1
  [ "$had" = true ] && herdr pane focus --pane "$pane" --direction down >/dev/null 2>&1
fi
# Splits come out even (or as asked); give the agent 60%, whichever side it is on.
python3 -I - "$agent" "$pane" <<'PY' 2>/dev/null
import json, os, socket, sys
agent, deck = sys.argv[1:]
def call(method, params):
    s = socket.socket(socket.AF_UNIX); s.connect(os.environ["HERDR_SOCKET_PATH"])
    s.sendall((json.dumps({"id": "steading", "method": method, "params": params}) + "\n").encode())
    buf = b""
    while not buf.endswith(b"\n"):
        buf += s.recv(65536)
    return json.loads(buf).get("result", {})
def find(node, path=()):
    if node["type"] == "split":
        a, b = node["first"], node["second"]
        if {a.get("pane_id"), b.get("pane_id")} == {agent, deck}:
            return list(path), a.get("pane_id") == agent
        return find(a, path + (False,)) or find(b, path + (True,))
root = call("layout.export", {"pane_id": agent})["layout"]["root"]
found = find(root)
if found:
    path, agent_first = found
    call("layout.set_split_ratio", {"pane_id": agent, "path": path, "ratio": 0.6 if agent_first else 0.4})
PY
printf '%s' "$pane" > "$base/pane"
printf '%s\n' "$placement" > "$base/placement"
printf '%s\n' "$pane"
