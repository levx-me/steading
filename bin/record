#!/usr/bin/env bash
# Claude Code PostToolUse / PostToolUseFailure hook (Bash): after the agent ran
# a command, record it in the deck when it holds a test run, a build, git or a deploy.
#
# Plain tests and builds were already rewritten to bin/run and recorded live.
# This catches the rest after the fact: tests and builds inside chains or pipes
# (`git status; forge test 2>&1 | grep FAIL`), and every git command. Nothing
# here changes the command, so Claude's own permission checks stay in place.
set -u

input=$(cat)
[ "${HERDR_ENV:-}" = 1 ] && [ -n "${HERDR_PANE_ID:-}" ] || exit 0
. "${0%/*}/py.sh"
# Every field this hook reads, in one jq call (@sh quotes each for eval). The command, the
# description and the error lose their trailing newlines, as $(...) used to take them off.
eval "$(printf '%s' "$input" | jq -r '@sh "cmd=\(.tool_input.command // "" | sub("\n+$"; ""))
  desc=\(.tool_input.description // "" | sub("\n+$"; "")) cwd=\(.cwd // "")
  event=\(.hook_event_name // "") id=\(.tool_use_id // "") err=\(.error // "" | sub("\n+$"; ""))
  ms=\(.duration_ms // 0 | floor) bg=\(.tool_response.backgroundTaskId? // "")"' 2>/dev/null)"
[ -n "${cmd:-}" ] || exit 0

# Its output and exit code into DIR (log, rc), from this event.
outcome() {
  if [ "$event" = PostToolUseFailure ]; then
    # "Exit code N" on the first line, then the combined output.
    local rc
    rc=$(printf '%s\n' "$err" | sed -n '1s/^Exit code \([0-9][0-9]*\).*/\1/p')
    printf '%s\n' "$err" | sed '1{/^Exit code [0-9]*$/d;}' > "$1/log"
    printf '%s\n' "${rc:-1}" > "$1/rc"
  else
    printf '%s' "$input" | jq -r '[.tool_response.stdout // "", .tool_response.stderr // ""] | map(select(. != "")) | join("\n")' > "$1/log"
    printf '0\n' > "$1/rc"
  fi
}

# A job bin/hook followed: kept with how it ended when it ran 5s or more (the lowest jobs
# threshold the deck's settings offer; it shows those past the one set), else dropped.
job=$(grep -lxF -- "$id" "${TMPDIR:-/tmp}/steading/${HERDR_PANE_ID//[:\/]/_}"/jobs/runs/*/id 2>/dev/null | head -n 1)
if [ -n "$id" ] && [ -n "$job" ]; then
  job=${job%/id}
  start=$(cat "$job/start" 2>/dev/null)
  if [ -n "$start" ] && [ $(( $(date +%s) - start )) -ge 5 ]; then
    outcome "$job"
    date +%s > "$job/end"
    rm -f "$job/source" # Claude Code removes its file once the call is done
  else
    rm -rf "$job"
  fi
fi

case $cmd in *"/bin/run\" "*) exit 0 ;; esac # routed through bin/run: already recorded

# What it ran, on shell tokens (bin/classify): test, build, deploy, or a git
# command that changes something. Read-only git, echo/grep mentioning a runner,
# and heredoc bodies do not count.
what=$(printf '%s' "$cmd" | "$py" -I "${0%/*}/classify")
eval "$(printf '%s' "$what" | jq -r '@sh "kind=\(.kind) label=\(.label) kinds=\(.kinds | join(" "))"')"
kinds=" $kinds "
# The session note asks for "<kind>: <command>" descriptions; one names the
# section and labels the run (read-only git stays out all the same).
# git and deploy only when the command really writes or ships (`vercel ls` is no deploy).
if [[ $desc =~ ^(test|build|git|deploy):[[:space:]]*(.+)$ ]] &&
  case ${BASH_REMATCH[1]} in git | deploy) [[ $kinds == *" ${BASH_REMATCH[1]} "* ]] ;; esac; then
  kind=${BASH_REMATCH[1]} label=${BASH_REMATCH[2]}
fi
[ -n "$kind" ] || exit 0

root=$(cd "${0%/*}/.." && pwd)
dir="${TMPDIR:-/tmp}/steading/${HERDR_PANE_ID//[:\/]/_}/$kind"
mkdir -p "$dir/runs"

keep=20; [ "$kind" = git ] && keep=50
n=$(ls "$dir/runs" | sort -n | tail -1); n=$(( ${n:-0} + 1 ))
ls "$dir/runs" | sort -rn | tail -n +"$keep" | while read -r old; do rm -rf "${dir:?}/runs/$old"; done
r="$dir/runs/$n"
mkdir -p "$r"

printf '%s\n' "$cmd" > "$r/cmd"
[ -n "$label" ] && printf '%s\n' "$label" > "$r/label"
printf '%s\n' "$cwd" > "$r/cwd"
# The branch a git command ran on: in the repo it cd's into last, else its cwd.
# Not for runs replayed from a transcript, whose branch then is unknown.
if [ "$kind" = git ] && [ -z "${STEADING_RESTORE_END:-}" ]; then
  repo=$(cat "$r/cwd")
  cd_to=$(printf '%s\n' "$cmd" | grep -oE '(^|[;&|(])[[:space:]]*cd[[:space:]]+[^;&|)[:space:]]+' | tail -n 1 | sed -E 's/.*cd[[:space:]]+//; s/^["'"'"']//; s/["'"'"']$//')
  if [ -n "$cd_to" ]; then
    case $cd_to in "~"*) cd_to="$HOME${cd_to#\~}" ;; /*) ;; *) cd_to="$repo/$cd_to" ;; esac
    repo=$cd_to
  fi
  git -C "$repo" symbolic-ref --short -q HEAD > "$r/branch" 2>/dev/null || rm -f "$r/branch"
fi
end=${STEADING_RESTORE_END:-$(date +%s)} # bin/restore passes the end from the transcript
printf '%s\n' "$(( end - ms / 1000 ))" > "$r/start"

if [ -n "$bg" ]; then
  # Sent to the background: this hook fires at launch, not at the end. Point the
  # deck at Claude's task output file instead; it follows it and reads the
  # "[exited with code N]" line Claude Code appends when the command ends.
  out=$(find "/private/tmp/claude-$UID" "${TMPDIR:-/tmp}/claude-$UID" -maxdepth 4 \
    -name "$bg.output" -print -quit 2>/dev/null)
  printf '%s\n' "${out:-}" > "$r/source"
  [ -n "$out" ] || printf '(running in the background as %s; output not found)\n' "$bg" > "$r/log"
else
  outcome "$r"
fi
[ -n "$bg" ] || printf '%s\n' "$end" > "$r/end"

# Bring an open deck to that section without holding up the agent.
[ -n "${STEADING_RESTORE_END:-}" ] && exit 0
cwd=$(cat "$r/cwd")
(cd "${cwd:-$PWD}" 2>/dev/null && "$root/bin/pane" --follow "$kind" >/dev/null 2>&1 &)
exit 0
