#!/usr/bin/env bash
# Claude Code hook (PostToolUse on any tool, Stop, UserPromptSubmit, SessionStart, and the
# subagents' SubagentStart, SubagentStop, TeammateIdle): hands the event to bin/sidebar.py in
# the background, so a tool call never waits on it. That reports the agent's repository and
# context use to herdr's sidebar. A subagent's start and stop, and a new process, are first
# recorded here, in the order the hooks run (bin/subagents.py): the $crew and the deck read them.
[ "${HERDR_ENV:-}" = 1 ] && [ -n "${HERDR_PANE_ID:-}" ] || exit 0
input=$(cat)
dir=$(dirname "$0")
. "$dir/py.sh"
if [[ $input =~ \"hook_event_name\"[[:space:]]*:[[:space:]]*\"(SubagentStart|SubagentStop|TeammateIdle|SessionStart)\" ]]; then
  printf '%s' "$input" | "$py" -I "$dir/subagents.py" >/dev/null 2>&1
  case ${BASH_REMATCH[1]} in SubagentStop | TeammateIdle) exit 0 ;; esac  # nothing more to report
fi
(printf '%s' "$input" | "$py" -I "$dir/sidebar.py" >/dev/null 2>&1 &)
exit 0
