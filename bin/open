#!/usr/bin/env bash
# Claude Code SessionStart hook, inside herdr only:
#  tells the agent how to run tests and builds so the deck can stream them
#  (every start, resume, /clear and compaction, so the note never drops out).
#  Opening the deck is herdr's job: the pane.agent_detected event (bin/deck auto)
#  does it for any agent.
set -u
input=$(cat)
[ "${HERDR_ENV:-}" = 1 ] && [ -n "${HERDR_PANE_ID:-}" ] || exit 0
. "$(dirname "$0")/py.sh"
[ -n "$(printf '%s' "$input" | jq -r '.agent_id // empty')" ] && exit 0 # not for subagents

# Runs are kept per herdr pane: a session resumed in a new pane (or after /tmp
# was cleared) refills its empty deck from the transcript, in the background.
base="${TMPDIR:-/tmp}/steading/$(printf '%s' "$HERDR_PANE_ID" | tr ':/' '__')"
transcript=$(printf '%s' "$input" | jq -r '.transcript_path // empty')
if [ -s "$transcript" ] && ! compgen -G "$base/*/runs/*" >/dev/null; then
  ("$py" -I "$(dirname "$0")/restore" "$transcript" >/dev/null 2>&1 &)
fi

note="Steading shows this session's tests, builds and git commands live in a herdr pane beside you. \
Run tests and builds as plain commands (\`forge test\`, \`npm test\`, \`./build.sh\`), not piped through \
grep/head/sed, redirected to a file, or chained with other commands: Steading then streams them with colour \
and still returns the full output and exit code to you. Append \`| tail -n N\` if you only need the end. \
Keep them in the foreground unless a run takes many minutes. \
You MUST give every test, build, git or deploy (vercel, fly, wrangler, terraform apply, forge script --broadcast, ...) Bash call a description of exactly \
\`<kind>: <core command>\`, where kind is test, build, git or deploy and the core command is the command line \
that does the work, copied as it runs, without cd, pipes, filters or redirects, never a sentence: \
\`test: forge test --match-path 'test/*'\`, \`build: pnpm build\`, \`git: git commit -m \"Fix X\" && git push\`, \
\`deploy: vercel --prod\`. Do this even when the call also does other things: Steading files the run under that \
kind and shows that line. \
Give every other Bash call a description too: what it does, in a few plain words (\`Measure how fast the \
sandbox starts\`), never the command itself. Steading shows it to the user as what you are doing."
jq -n --arg note "$note" '{hookSpecificOutput: {hookEventName: "SessionStart", additionalContext: $note}}'
